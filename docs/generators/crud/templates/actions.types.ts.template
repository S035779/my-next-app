export type AppErrorCode =
  | "VALIDATION_ERROR"
  | "UNAUTHORIZED"
  | "FORBIDDEN"
  | "NOT_FOUND"
  | "CONFLICT"
  | "INTERNAL";

export class <AppError> extends Error {
  public readonly code: AppErrorCode;
  public readonly details?: unknown;

  private constructor(code: AppErrorCode, message: string, details?: unknown) {
    super(message);
    this.code = code;
    this.details = details;
  }

  static validation(err: ZodError) {
    return new <AppError>("VALIDATION_ERROR", "Validation error", err.flatten());
  }
  static unauthorized() {
    return new <AppError>("UNAUTHORIZED", "Unauthorized");
  }
  static forbidden() {
    return new <AppError>("FORBIDDEN", "Forbidden");
  }
  static notFound(resource: string) {
    return new <AppError>("NOT_FOUND", `${resource} not found`);
  }
  static conflict(message = "Conflict") {
    return new <AppError>("CONFLICT", message);
  }
  static internal(message = "Internal error") {
    return new <AppError>("INTERNAL", message);
  }
}