{
  "name": "my-next-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:seed": "dotenv -e .env.local -- tsx src/db/seed.ts",
    "db:reset": "dotenv -e .env.local -- tsx src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:migrate:test": "dotenv -e .env.local -- sh -c 'DATABASE_URL=$DATABASE_URL_TEST drizzle-kit migrate'",
    "db:seed:test": "dotenv -e .env.local -- sh -c 'DATABASE_URL=$DATABASE_URL_TEST tsx src/db/seed.ts'",
    "db:reset:test": "dotenv -e .env.local -- sh -c 'DB_URL=$DATABASE_URL_TEST tsx src/db/reset.ts' && pnpm db:migrate:test && pnpm db:seed:test",
    "test": "pnpm test:db && vitest run",
    "test:watch": "pnpm test:db && vitest",
    "test:db": "dotenv -e .env.local -- sh -c 'DB_URL=$DATABASE_URL_TEST tsx src/db/reset.ts && DATABASE_URL=$DATABASE_URL_TEST drizzle-kit migrate && DATABASE_URL=$DATABASE_URL_TEST tsx src/db/seed.ts'",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report --host 0.0.0.0 --port 9323"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.10",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.563.0",
    "mysql2": "^3.16.1",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@clerk/testing": "^1.13.35",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
