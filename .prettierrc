{
    "singleQuote": true,
    "semi": true,
    "tabWidth": 4,
    "overrides": [
        {
            "files": "*.md",
            "options": { "tabWidth": 2 }
        },
        {
            "files": ["*.ts", "*.tsx"],
            "options": { "tabWidth": 4 }
        },
        {
            "files": "*.json",
            "options": { "tabWidth": 4 }
        }
    ]
}
